# 复制为 .env 后再启动 Compose。
# 留空表示内网免登录；对外提供服务时请设置一段足够长的随机值。
MAIL2BARK_ADMIN_KEY=
MAIL2BARK_HTTP_ADDR=:8080
MAIL2BARK_SMTP_ADDR=:2525
MAIL2BARK_SMTP_STARTTLS_ADDR=
MAIL2BARK_SMTP_TLS_ADDR=
MAIL2BARK_DB_PATH=/data/mail2bark.db
MAIL2BARK_RECIPIENT_DOMAIN=notify.internal
MAIL2BARK_MAX_MESSAGE_BYTES=10485760

# 启用 STARTTLS 或隐式 TLS 时填写证书路径。
MAIL2BARK_TLS_CERT=/certs/fullchain.pem
MAIL2BARK_TLS_KEY=/certs/privkey.pem

# 仅在启用可选的 Caddy profile 时使用。
MAIL2BARK_DOMAIN=notify.example.com
